# Copy this file to .env and fill in your own values

# Port the Express server will run on
PORT=5000

# MongoDB connection string
# Local MongoDB:      mongodb://127.0.0.1:27017/smart_tech_events_hub
# MongoDB Atlas:       mongodb+srv://<user>:<password>@cluster0.mongodb.net/smart_tech_events_hub
MONGO_URI=mongodb://127.0.0.1:27017/smart_tech_events_hub

# Secret used to sign JWT tokens - use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# URL of the frontend (used for CORS)
CLIENT_URL=http://localhost:3000

# Default password given to seeded accounts (change after first login)
SEED_PASSWORD=Passw0rd!
